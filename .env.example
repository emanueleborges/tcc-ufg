# Docker Compose — variáveis opcionais

# Ollama no host (padrão no macOS/Linux com Docker Desktop / host-gateway)
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Modelo de embeddings (baixado na 1ª execução e cacheado no volume)
RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-small
